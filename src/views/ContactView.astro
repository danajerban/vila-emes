---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import ContactSidebar from "../components/ContactSidebar.astro";
import Directions from "../components/Directions.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import ReadyToBookCTA from "../components/ReadyToBookCTA.astro";
import SectionDivider from "../components/SectionDivider.astro";
import { getSite } from "../i18n/content";
import { localizedPath, type Lang } from "../i18n/locales";
import { breadcrumbListJsonLd, jsonLdScriptBody } from "../lib/seo";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const site = await getSite(lang);
const ui = site.data.ui;
const page = site.data.contact_page;
const home = site.data.home;

const breadcrumbLd = breadcrumbListJsonLd([
  { name: ui.nav.home, path: localizedPath(lang, "/") },
  { name: ui.nav.contact, path: localizedPath(lang, "/contact") },
]);
---
<Base lang={lang} title={site.data.seo.contact.title} description={site.data.seo.contact.description}>
  <Header lang={lang} ui={ui.nav} hotelName={site.data.hotel.name} bookLabel={ui.buttons.book_short ?? "Book us"} menuToggleLabel={ui.aria_labels.menu_toggle} />
  <script is:inline type="application/ld+json" set:html={jsonLdScriptBody(breadcrumbLd)}></script>

  <PageHero
    eyebrow={page.hero_eyebrow}
    headingPart1={page.hero_heading_part_1}
    headingPart2Handwritten={page.hero_heading_part_2_handwritten}
    intro={page.hero_intro}
  />

  <section class="max-w-[1180px] mx-auto px-5 md:px-10 py-12 md:py-16 grid md:grid-cols-5 gap-12 reveal">
    <div class="md:col-span-3">
      <ContactForm
        heading={page.form.heading}
        intro={page.form.intro}
        fields={page.form.fields}
        submit={page.form.submit}
        mailto={page.form.mailto}
      />
    </div>
    <div class="md:col-span-2">
      <ContactSidebar
        addressLabel={page.sidebar.address_label}
        hoursLabel={page.sidebar.hours_label}
        frontDeskLabel={page.sidebar.front_desk_label}
        frontDeskValue={page.sidebar.front_desk_value}
        checkInLabel={page.sidebar.check_in_label}
        checkOutLabel={page.sidebar.check_out_label}
        speakToLabel={page.sidebar.speak_to_label}
        speakToName={page.sidebar.speak_to_name}
        speakToRole={page.sidebar.speak_to_role}
        speakToHandwritten={page.sidebar.speak_to_handwritten}
      />
    </div>
  </section>

  <SectionDivider />

  <Directions
    eyebrow={page.directions.eyebrow}
    heading={page.directions.heading}
    mapsCta={ui.buttons.map}
  />

  <SectionDivider />

  <FAQ
    eyebrow={home.faq.eyebrow}
    headingPart1={home.faq.heading_part_1}
    headingPart2Handwritten={home.faq.heading_part_2_handwritten}
    items={home.faq.items}
    variant="subbg"
  />

  {home.ready_cta && (
    <>
      <SectionDivider />
      <ReadyToBookCTA
        handwritten={home.ready_cta.handwritten}
        heading={home.ready_cta.heading}
        sub={home.ready_cta.sub}
        bookLabel={home.ready_cta.book_label}
        mapLabel={home.ready_cta.map_label}
      />
    </>
  )}

  <Footer lang={lang} handwritten={ui.footer.handwritten} copyright={ui.footer.copyright} visitLabel={ui.footer.visit_label} reachLabel={ui.footer.reach_label} ui={ui} />
</Base>
