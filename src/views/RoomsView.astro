import imgDeluxeQueen3 from "../assets/photos/deluxe-rooms/dsc-0353-1600.webp";
import imgDeluxeQueen4 from "../assets/photos/deluxe-rooms/dsc-0345-1600.webp";
import imgDeluxeQueen5 from "../assets/photos/deluxe-rooms/dsc-0346-1600.webp";
import imgDeluxeQueen6 from "../assets/photos/deluxe-rooms/dsc-0358-1600.webp";

// deluxe-king (source folder 103)
import imgDeluxeKing1 from "../assets/photos/deluxe-rooms/dsc-0370-1600.webp";
import imgDeluxeKing2 from "../assets/photos/deluxe-rooms/dsc-0371-1600.webp";
import imgDeluxeKing3 from "../assets/photos/deluxe-rooms/dsc-0368-1600.webp";
