import imgFamilyStd3  from "../assets/photos/standard-rooms/dsc-0406-1600.webp";
import imgFamilyStd4  from "../assets/photos/standard-rooms/dsc-0407-1600.webp";
import imgFamilyStd5  from "../assets/photos/standard-rooms/dsc-0430-1600.webp";
import imgFamilyStd6  from "../assets/photos/standard-rooms/dsc-0431-1600.webp";
import imgFamilyStd7  from "../assets/photos/standard-rooms/dsc-0433-1600.webp";

// Economy — 7 photos each (own files + a few overlaps with family/quad,
// since /standard-rooms/ has limited unique frames; content review can curate)
import imgEconTriple1   from "../assets/photos/standard-rooms/dsc-0411-1600.webp";
import imgEconTriple2   from "../assets/photos/standard-rooms/dsc-0412-1600.webp";
import imgEconTriple3   from "../assets/photos/standard-rooms/dsc-0413-1600.webp";
import imgEconTriple4   from "../assets/photos/standard-rooms/dsc-0414-1600.webp";

import imgBudgetTriple1 from "../assets/photos/standard-rooms/dsc-0420-1600.webp";
import imgBudgetTriple2 from "../assets/photos/standard-rooms/dsc-0421-1600.webp";
import imgBudgetTriple3 from "../assets/photos/standard-rooms/dsc-0422-1600.webp";
import imgBudgetTriple4 from "../assets/photos/standard-rooms/dsc-0425-1600.webp";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const site = await getSite(lang);
const ui = site.data.ui;
const page = site.data.rooms_page;
const home = site.data.home;
const rooms = site.data.rooms;

const roomPhotos: Record<string, ImageMetadata[]> = {
  "apt-1bed-terrace": [imgApt1Bed1, imgApt1Bed2, imgApt1Bed3, imgApt1Bed4, imgApt1Bed5, imgApt1Bed6, imgApt1Bed7],
  "apt-2bed":         [imgApt2Bed1, imgApt2Bed2, imgApt2Bed3, imgApt2Bed4, imgApt2Bed5, imgApt2Bed6, imgApt2Bed7],
  "deluxe-king":      [imgDeluxeKing1, imgDeluxeKing2, imgDeluxeKing3, imgDeluxeKing4, imgDeluxeKing5, imgDeluxeKing6, imgDeluxeKing7],
  "deluxe-queen":     [imgDeluxeQueen1, imgDeluxeQueen2, imgDeluxeQueen3, imgDeluxeQueen4, imgDeluxeQueen5, imgDeluxeQueen6, imgDeluxeQueen7],
  "deluxe-balcony":   [imgDeluxeBalc1, imgDeluxeBalc2, imgDeluxeBalc3, imgDeluxeBalc4, imgDeluxeBalc5, imgDeluxeBalc6, imgDeluxeBalc7],
  "quad-sea":         [imgQuadSea1, imgQuadSea2, imgQuadSea3, imgQuadSea4, imgQuadSea5, imgQuadSea6, imgQuadSea7],
  "quad-balcony":     [imgQuadBalc1, imgQuadBalc2, imgQuadBalc3, imgQuadBalc4, imgQuadBalc5, imgQuadBalc6, imgQuadBalc7],
  "family-balcony":   [imgFamilyBalc1, imgFamilyBalc2, imgFamilyBalc3, imgFamilyBalc4, imgFamilyBalc5, imgFamilyBalc6, imgFamilyBalc7],
  "family-standard":  [imgFamilyStd1, imgFamilyStd2, imgFamilyStd3, imgFamilyStd4, imgFamilyStd5, imgFamilyStd6, imgFamilyStd7],
  "econ-triple":      [imgEconTriple1, imgEconTriple2, imgEconTriple3, imgEconTriple4, imgQuadSea3, imgQuadSea7, imgFamilyBalc5],
  "budget-triple":    [imgBudgetTriple1, imgBudgetTriple2, imgBudgetTriple3, imgBudgetTriple4, imgQuadBalc5, imgFamilyBalc6, imgFamilyStd6],
};

const orderedRooms = [...rooms].sort((a, b) => a.order - b.order);
---
<Base lang={lang} title={site.data.seo.rooms.title} description={site.data.seo.rooms.description}>
  <Header lang={lang} ui={ui.nav} hotelName={site.data.hotel.name} bookLabel={ui.buttons.book_short ?? "Book us"} menuToggleLabel={ui.aria_labels.menu_toggle} />

  <PageHero
    eyebrow={page.hero_eyebrow}
    headingPart1={page.hero_heading_part_1}
    headingPart2Handwritten={page.hero_heading_part_2_handwritten}
    intro={page.hero_intro}
    tightBottom
  >
    <RoomFilterBar labels={ui.filter} />
  </PageHero>

  <main class="rooms-main">
    {orderedRooms.map((r, i) => (
      <>
        {i > 0 && <SectionDivider class="my-0" />}
        <RoomDetails
          id={r.id}
          cat={r.family}
          numberLabel={String(r.order).padStart(2, "0")}
          familyLabel={ui.family_groups[r.family]}
          name={r.name}
          size={`${r.size_m2} m²`}
          beds={r.beds}
          view={r.view}
          outdoor={r.outdoor}
          capacity={r.sleeps_label}
          description={r.description}
          amenities={r.amenities.map((kind) => ({ kind, label: ui.amenity_labels[kind] }))}
          photos={roomPhotos[r.id]}
          bookHref={SITE.links.booking_com}
          bookLabel={ui.buttons.book}
          flip={i % 2 === 1}
          labels={ui.labels}
        />
      </>
    ))}
  </main>

  <SectionDivider />

  <RoomsIncludes
    eyebrow={page.includes.eyebrow}
    heading={page.includes.heading}
    handwritten={page.includes.handwritten}
    pastryNote={page.includes.pastry_note}
    list={page.includes.list}
  />

  <SectionDivider />

  <HouseRules
    eyebrow={page.rules.eyebrow}
    heading={page.rules.heading}
    checkIn={page.rules.check_in}
    checkOut={page.rules.check_out}
    notes={page.rules.notes}
  />

  {home.ready_cta && (
    <>
      <SectionDivider />
      <ReadyToBookCTA
        handwritten={home.ready_cta.handwritten}
        heading={home.ready_cta.heading}
        sub={home.ready_cta.sub}
        bookLabel={home.ready_cta.book_label}
        mapLabel={home.ready_cta.map_label}
      />
    </>
  )}

  <Footer lang={lang} handwritten={ui.footer.handwritten} copyright={ui.footer.copyright} visitLabel={ui.footer.visit_label} reachLabel={ui.footer.reach_label} ui={ui} />
</Base>
