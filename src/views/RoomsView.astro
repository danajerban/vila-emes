import imgQuadSea2 from "../assets/photos/standard-rooms/dsc-0381-1600.webp";
import imgQuadSea3 from "../assets/photos/standard-rooms/dsc-0382-1600.webp";
import imgQuadSea4 from "../assets/photos/standard-rooms/dsc-0391-1600.webp";
import imgQuadSea5 from "../assets/photos/standard-rooms/dsc-0393-1600.webp";
import imgQuadSea6 from "../assets/photos/standard-rooms/dsc-0386-1600.webp";
import imgQuadSea7 from "../assets/photos/standard-rooms/dsc-0384-1600.webp";

// family-balcony-city (merged source folders 203/303 + 205/305)
import imgFamilyBalcCity1 from "../assets/photos/standard-rooms/dsc-0405-1600.webp";
import imgFamilyBalcCity2 from "../assets/photos/standard-rooms/dsc-0428-1600.webp";
import imgFamilyBalcCity3 from "../assets/photos/standard-rooms/dsc-0433-1600.webp";
import imgFamilyBalcCity4 from "../assets/photos/standard-rooms/dsc-0399-1600.webp";
import imgFamilyBalcCity5 from "../assets/photos/standard-rooms/dsc-0410-1600.webp";
import imgFamilyBalcCity6 from "../assets/photos/standard-rooms/dsc-0429-1600.webp";
import imgFamilyBalcCity7 from "../assets/photos/standard-rooms/dsc-0430-1600.webp";

// family-balcony (sea, source folder 206/306) — 4 own photos + 0393 borrowed from quad-sea (both rooms have sea-view balcony; 306's photoset lacks a sea-view balcony shot)
import imgFamilyBalc1 from "../assets/photos/standard-rooms/dsc-0411-1600.webp";
import imgFamilyBalc2 from "../assets/photos/standard-rooms/dsc-0414-1600.webp";
import imgFamilyBalc3 from "../assets/photos/standard-rooms/dsc-0412-1600.webp";
import imgFamilyBalc4 from "../assets/photos/standard-rooms/dsc-0413-1600.webp";

// triple-room (merged source folders 202/302 + 204/304)
import imgTriple1 from "../assets/photos/standard-rooms/dsc-0418-1600.webp";
import imgTriple2 from "../assets/photos/standard-rooms/dsc-0420-1600.webp";
import imgTriple3 from "../assets/photos/standard-rooms/dsc-0417-1600.webp";
import imgTriple4 from "../assets/photos/standard-rooms/dsc-0421-1600.webp";
import imgTriple5 from "../assets/photos/standard-rooms/dsc-0422-1600.webp";
import imgTriple6 from "../assets/photos/standard-rooms/dsc-0403-1600.webp";
import imgTriple7 from "../assets/photos/standard-rooms/dsc-0394-1600.webp";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const site = await getSite(lang);
const ui = site.data.ui;
const page = site.data.rooms_page;
const home = site.data.home;
const rooms = site.data.rooms;

const roomPhotos: Record<string, ImageMetadata[]> = {
  "apt-1bed-terrace":    [imgApt1Bed1, imgApt1Bed2, imgApt1Bed3, imgApt1Bed4, imgApt1Bed5, imgApt1Bed6, imgApt1Bed7],
  "apt-2bed":            [imgApt2Bed1, imgApt2Bed2, imgApt2Bed3, imgApt2Bed4, imgApt2Bed5, imgApt2Bed6, imgApt2Bed7],
  "deluxe-king":         [imgDeluxeKing1, imgDeluxeKing2, imgDeluxeKing3, imgDeluxeKing4, imgDeluxeKing5, imgDeluxeKing6],
  "deluxe-queen":        [imgDeluxeQueen1, imgDeluxeQueen2, imgDeluxeQueen3, imgDeluxeQueen4, imgDeluxeQueen5, imgDeluxeQueen6],
  "deluxe-balcony":      [imgDeluxeBalc1, imgDeluxeBalc2, imgDeluxeBalc3, imgDeluxeBalc4, imgDeluxeBalc5, imgDeluxeBalc6, imgDeluxeBalc7],
  "quad-sea":            [imgQuadSea1, imgQuadSea2, imgQuadSea3, imgQuadSea4, imgQuadSea5, imgQuadSea6, imgQuadSea7],
  "family-balcony-city": [imgFamilyBalcCity1, imgFamilyBalcCity2, imgFamilyBalcCity3, imgFamilyBalcCity4, imgFamilyBalcCity5, imgFamilyBalcCity6, imgFamilyBalcCity7],
  "family-balcony":      [imgFamilyBalc1, imgFamilyBalc2, imgFamilyBalc3, imgFamilyBalc4, imgQuadSea5],
  "triple-room":         [imgTriple1, imgTriple2, imgTriple3, imgTriple4, imgTriple5, imgTriple6, imgTriple7],
};

const orderedRooms = [...rooms].sort((a, b) => a.order - b.order);

const breadcrumbLd = breadcrumbListJsonLd([
  { name: ui.nav.home, path: localizedPath(lang, "/") },
  { name: ui.nav.rooms, path: localizedPath(lang, "/rooms") },
]);

// HotelRoom @graph — one entry per layout. Pricing is owned by Booking.com,
// so Offers/priceRange are intentionally omitted (placeholders hurt rich
// results harder than missing fields).
const roomsLd = hotelRoomGraphJsonLd(
  orderedRooms.map((r) => ({
    name: r.name,
    description: r.description,
    size_m2: r.size_m2,
    sleeps: r.sleeps,
    beds: r.beds,
    amenities: r.amenities,
  })),
);
---
<Base lang={lang} title={site.data.seo.rooms.title} description={site.data.seo.rooms.description}>
  <Header lang={lang} ui={ui.nav} hotelName={site.data.hotel.name} bookLabel={ui.buttons.book_short ?? "Book us"} menuToggleLabel={ui.aria_labels.menu_toggle} />
  <script is:inline type="application/ld+json" set:html={jsonLdScriptBody(breadcrumbLd)}></script>
  <script is:inline type="application/ld+json" set:html={jsonLdScriptBody(roomsLd)}></script>

  <PageHero
    eyebrow={page.hero_eyebrow}
    headingPart1={page.hero_heading_part_1}
    headingPart2Handwritten={page.hero_heading_part_2_handwritten}
    intro={page.hero_intro}
    tightBottom
  >
    <RoomFilterBar labels={ui.filter} />
  </PageHero>

  <main class="rooms-main">
    {orderedRooms.map((r, i) => (
      <>
        {i > 0 && <SectionDivider class="my-0" />}
        <RoomDetails
          id={r.id}
          cat={r.family}
          numberLabel={String(r.order).padStart(2, "0")}
          familyLabel={ui.family_groups[r.family]}
          name={r.name}
          size={`${r.size_m2} m²`}
          beds={r.beds}
          view={r.view}
          outdoor={r.outdoor}
          capacity={r.sleeps_label}
          description={r.description}
          amenities={r.amenities.map((kind) => ({ kind, label: ui.amenity_labels[kind] }))}
          photos={roomPhotos[r.id]}
          bookHref={SITE.links.booking_com}
          bookLabel={ui.buttons.book}
          flip={i % 2 === 1}
          labels={ui.labels}
        />
      </>
    ))}
  </main>

  <SectionDivider />

  <RoomsIncludes
    eyebrow={page.includes.eyebrow}
    heading={page.includes.heading}
    handwritten={page.includes.handwritten}
    pastryNote={page.includes.pastry_note}
    list={page.includes.list}
  />

  <SectionDivider />

  <HouseRules
    eyebrow={page.rules.eyebrow}
    heading={page.rules.heading}
    checkIn={page.rules.check_in}
    checkOut={page.rules.check_out}
    notes={page.rules.notes}
  />

  {home.ready_cta && (
    <>
      <SectionDivider />
      <ReadyToBookCTA
        handwritten={home.ready_cta.handwritten}
        heading={home.ready_cta.heading}
        sub={home.ready_cta.sub}
        bookLabel={home.ready_cta.book_label}
        mapLabel={home.ready_cta.map_label}
      />
    </>
  )}

  <Footer lang={lang} handwritten={ui.footer.handwritten} copyright={ui.footer.copyright} visitLabel={ui.footer.visit_label} reachLabel={ui.footer.reach_label} ui={ui} />
</Base>
