---
import Eyebrow from "./Eyebrow.astro";
import LocationMap from "./LocationMap.astro";
import { SITE } from "../config/site";

interface Props {
  eyebrow: string;
  heading: string;
  blurbs: string[];
  mapsCta: string;
}
const { eyebrow, heading, blurbs, mapsCta } = Astro.props;
---
<section class="reveal">
  <div class="max-w-[1180px] mx-auto px-5 md:px-10 py-12 md:py-16">
    <div class="text-center max-w-2xl mx-auto">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="mt-3 font-serif text-3xl md:text-4xl text-[color:var(--color-ink)]">{heading}</h2>
    </div>
    <div class="mt-12 grid md:grid-cols-2 gap-10 md:gap-16 items-start">
      <ul class="divide-y divide-[color:var(--color-divider)]">
        {SITE.distances.map((d, i) => {
          const match = d.value.match(/^([\d.]+)\s*(\S+)$/);
          const num = match ? match[1] : d.value;
          const unit = match ? match[2] : "";
          return (
            <li class="py-5 grid grid-cols-[5rem_1fr] gap-x-6 items-baseline md:grid-cols-[6rem_1fr]">
              <div class="text-center">
                <div class="font-serif text-4xl md:text-5xl text-[color:var(--color-terracotta)] tabular-nums leading-none">{num}</div>
                <div class="mt-2 text-base md:text-lg uppercase tracking-[0.2em] font-medium text-[color:var(--color-muted)]">{unit}</div>
              </div>
              <div>
                <p class="font-medium text-[color:var(--color-ink)] text-lg">{d.label}</p>
                <p class="text-base md:text-lg text-[color:var(--color-muted)] mt-1">{blurbs[i]}</p>
              </div>
            </li>
          );
        })}
      </ul>
      <div class="space-y-5 text-center md:text-left">
        <LocationMap embedUrl={SITE.links.google_maps_embed} ariaLabel="Vila Emes location on Google Maps" />
        <a
          href={SITE.links.google_maps}
          target="_blank" rel="noopener"
          class="inline-flex items-center px-5 py-3 border border-[color:var(--color-sea)] text-[color:var(--color-sea)] hover:bg-[color:var(--color-sea)] hover:text-[color:var(--color-cream)] rounded-md transition"
        >{mapsCta}</a>
      </div>
    </div>
  </div>
</section>
