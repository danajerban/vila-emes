---
import Handwritten from "./Handwritten.astro";
import Eyebrow from "./Eyebrow.astro";

type TrustQuote = { text: string; author: string; location: string; when?: string };

interface Props {
  bookingLabel: string;
  bookingScore: number;
  googleLabel: string;
  googleScore: number;
  quotes: TrustQuote[];
  moreLabel: string;
  readAllReviewsLabel: string;
  readAllReviewsUrl: string;
}
const { bookingLabel, bookingScore, googleLabel, googleScore, quotes, moreLabel, readAllReviewsLabel, readAllReviewsUrl } = Astro.props;
const [anchor, ...supporting] = quotes;
---
<section class="bg-[color:var(--color-sub-bg)] reveal">
  <div class="max-w-[1180px] mx-auto px-5 md:px-10 py-16 md:py-20">
    <div class="max-w-3xl mx-auto text-center">
      <figure>
        <svg width="32" height="26" viewBox="0 0 28 22" class="text-[color:var(--color-terracotta)] mb-4 mx-auto" fill="currentColor" aria-hidden="true">
          <path d="M0 14c0-4.5 3.2-8.4 7.6-9l1 1.7c-2.6.5-4.6 2.7-4.6 5.5h3.6V22H0V14zm14.4 0c0-4.5 3.2-8.4 7.6-9l1 1.7c-2.6.5-4.6 2.7-4.6 5.5H22V22h-7.6V14z"/>
        </svg>

        <blockquote class="font-serif text-2xl md:text-3xl text-[color:var(--color-ink)] leading-snug italic">
          {anchor.text}
        </blockquote>

        <figcaption class="mt-5 text-base md:text-lg text-[color:var(--color-muted)]">
          <span class="font-medium text-[color:var(--color-ink)]">{anchor.author}</span>
          <span> · </span>{anchor.location}
          {anchor.when && (<><span> · </span><Handwritten as="span" color="terracotta">{anchor.when}</Handwritten></>)}
        </figcaption>
      </figure>

      <div class="mt-12 flex flex-wrap justify-center items-baseline gap-x-12 md:gap-x-16 gap-y-4">
        <div class="flex items-baseline gap-3">
          <span class="font-serif text-6xl md:text-7xl text-[color:var(--color-terracotta)] tabular-nums leading-none" data-count-up={bookingScore} data-count-decimals="1">0.0</span>
          <span class="text-base md:text-lg uppercase tracking-[0.2em] font-medium text-[color:var(--color-muted)]">{bookingLabel}</span>
        </div>
        <div class="flex items-baseline gap-3">
          <span class="font-serif text-6xl md:text-7xl text-[color:var(--color-terracotta)] tabular-nums leading-none" data-count-up={googleScore} data-count-decimals="1">0.0</span>
          <span class="text-base md:text-lg uppercase tracking-[0.2em] font-medium text-[color:var(--color-muted)]">{googleLabel} · ★</span>
        </div>
      </div>
    </div>

    {supporting.length > 0 && (
      <div class="mt-16 md:mt-20 pt-12 md:pt-16 border-t border-[color:var(--color-divider)]">
        <div class="text-center">
          <Eyebrow>{moreLabel}</Eyebrow>
        </div>
        <div class="mt-8 md:mt-10 grid grid-cols-1 md:grid-cols-3 gap-x-10 md:gap-x-12 reveal-stagger">
          {supporting.map((q, i) => (
            <figure class:list={[
              "text-center",
              i > 0 && "mt-10 pt-10 border-t border-[color:var(--color-divider)] md:mt-0 md:pt-0 md:border-t-0",
            ]}>
              <svg width="20" height="16" viewBox="0 0 28 22" class="text-[color:var(--color-terracotta)] mb-3 mx-auto" fill="currentColor" aria-hidden="true">
                <path d="M0 14c0-4.5 3.2-8.4 7.6-9l1 1.7c-2.6.5-4.6 2.7-4.6 5.5h3.6V22H0V14zm14.4 0c0-4.5 3.2-8.4 7.6-9l1 1.7c-2.6.5-4.6 2.7-4.6 5.5H22V22h-7.6V14z"/>
              </svg>
              <blockquote class="font-serif italic text-[17px] md:text-[18px] leading-relaxed text-[color:var(--color-ink)]">
                {q.text}
              </blockquote>
              <figcaption class="mt-4 text-base text-[color:var(--color-muted)]">
                <span class="font-medium text-[color:var(--color-ink)]">{q.author}</span>
                <span> · </span>{q.location}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    )}

    <div class="text-center">
      <a
        href={readAllReviewsUrl}
        target="_blank"
        rel="noopener"
        class="handwritten text-[color:var(--color-terracotta)] text-2xl md:text-3xl mt-10 inline-block hover:underline"
      >{readAllReviewsLabel}</a>
    </div>
  </div>
</section>
