---
interface Props {
  embedUrl: string;
  ariaLabel: string;
}
const { embedUrl, ariaLabel } = Astro.props;
---
<div class="w-full aspect-[4/3] rounded-md overflow-hidden border border-[color:var(--color-divider)]" aria-label={ariaLabel}>
  <iframe
    src={embedUrl}
    title={ariaLabel}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="w-full h-full block"
  ></iframe>
</div>
