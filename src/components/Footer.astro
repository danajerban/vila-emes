---
import { Image } from "astro:assets";
import LangSwitch from "./LangSwitch.astro";
import Eyebrow from "./Eyebrow.astro";
import logoPng from "../assets/logo/vila-emes-1024.png";
import { localizedPath, type Lang } from "../i18n/locales";
import { SITE } from "../config/site";

interface Props {
  lang: Lang;
  handwritten: string;
  copyright: string;
  visitLabel: string;
  reachLabel: string;
  ui: {
    nav: { home: string; rooms: string; contact: string };
    buttons: { book: string; map: string };
  };
}
const { lang, handwritten, copyright, visitLabel, reachLabel, ui } = Astro.props;
---
<footer class="bg-[color:var(--color-cream-elevated)] border-t border-[color:var(--color-divider)]">
  <div class="max-w-[1280px] mx-auto px-5 md:px-10 py-14 md:py-20">
    <!-- Desktop: 3 equal columns (Brand | Visit | Reach), vertically centered. Mobile: brand block stacks, then Visit+Reach side-by-side. -->
    <div class="grid md:grid-cols-3 gap-12 md:gap-16 md:items-center">
      <!-- Brand column -->
      <div class="text-center md:text-left">
        <Image src={logoPng} alt="Vila Emes" width={140} height={140} class="opacity-90 mx-auto md:mx-0" />
        <address class="mt-3 not-italic text-[15px] text-[color:var(--color-muted)] leading-relaxed space-y-0.5">
          {SITE.contact.address.map((line) => <p>{line}</p>)}
        </address>
        <div class="mt-4 flex justify-center md:justify-start">
          <LangSwitch lang={lang} variant="inline" />
        </div>
      </div>

      <!-- Mobile: 2-col grid wrapping Visit+Reach. Desktop: display:contents so Visit and Reach become direct children of the outer 3-col grid. -->
      <div class="grid grid-cols-2 gap-8 md:contents text-left">
        <nav aria-label={visitLabel}>
          <Eyebrow>{visitLabel}</Eyebrow>
          <ul class="mt-4 space-y-2.5 text-[15px]">
            <li><a href={localizedPath(lang, "/")} class="hover:text-[color:var(--color-terracotta)] transition">{ui.nav.home}</a></li>
            <li><a href={localizedPath(lang, "/rooms")} class="hover:text-[color:var(--color-terracotta)] transition">{ui.nav.rooms}</a></li>
            <li><a href={localizedPath(lang, "/contact")} class="hover:text-[color:var(--color-terracotta)] transition">{ui.nav.contact}</a></li>
          </ul>
        </nav>

        <div>
          <Eyebrow>{reachLabel}</Eyebrow>
          <ul class="mt-4 space-y-2.5 text-[15px]">
            <li><a href={`tel:${SITE.contact.phone.replace(/\s+/g, "")}`} class="hover:text-[color:var(--color-terracotta)] transition tabular-nums">{SITE.contact.phone}</a></li>
            <li><a href={`mailto:${SITE.contact.email}`} class="hover:text-[color:var(--color-terracotta)] transition break-all">{SITE.contact.email}</a></li>
            <li><a href={SITE.links.instagram} target="_blank" rel="noopener" class="hover:text-[color:var(--color-terracotta)] transition">Instagram</a></li>
          </ul>
        </div>
      </div>
    </div>

    <hr class="mt-14 md:mt-16 border-[color:var(--color-divider)]" />

    <div class="mt-6 flex flex-col md:flex-row items-center md:justify-between gap-4 text-center md:text-left">
      <p class="handwritten text-xl text-[color:var(--color-terracotta)]">— {handwritten} —</p>
      <div class="flex items-center gap-5">
        <ul class="flex items-center gap-2.5">
          <li><img src="/payments/apple-pay.svg" alt="Apple Pay" class="h-5 w-auto" /></li>
          <li><img src="/payments/visa.svg" alt="Visa" class="h-5 w-auto" /></li>
          <li><img src="/payments/mastercard.svg" alt="Mastercard" class="h-5 w-auto" /></li>
          <li><img src="/payments/cash.svg" alt="Cash" class="h-5 w-auto" /></li>
          <li><img src="/payments/google-pay.svg" alt="Google Pay" class="h-5 w-auto" /></li>
        </ul>
        <p class="text-xs text-[color:var(--color-muted)] tracking-wide">{copyright}</p>
      </div>
    </div>
  </div>
</footer>

