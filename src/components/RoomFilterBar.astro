---
interface Props {
  labels: { all: string; apartments: string; deluxe: string; family: string; standard: string };
}
const { labels } = Astro.props;
const cats = [
  { value: "all",         label: labels.all },
  { value: "apartments",  label: labels.apartments },
  { value: "deluxe",      label: labels.deluxe },
  { value: "family",      label: labels.family },
  { value: "standard",    label: labels.standard },
];
---
<div class="mt-10 flex justify-center">
  <div class="inline-flex flex-wrap justify-center gap-1.5 p-1.5 rounded-3xl bg-[color:var(--color-cream-elevated)] border border-[color:var(--color-divider)]" role="tablist" aria-label="Filter rooms">
    {cats.map((c, i) => (
      <button
        type="button"
        data-filter={c.value}
        class={`room-filter-btn px-3.5 py-1.5 rounded-full text-[13px] tracking-wide transition ${i === 0 ? "is-active" : ""}`}
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
      >{c.label}</button>
    ))}
  </div>
</div>

<style>
  .room-filter-btn {
    color: var(--color-ink);
    background: transparent;
  }
  .room-filter-btn.is-active {
    background: var(--color-terracotta);
    color: var(--color-cream);
  }
  .room-filter-btn:not(.is-active):hover {
    background: var(--color-sub-bg);
  }
</style>

<script is:inline>
  (function () {
    function init() {
      const btns = document.querySelectorAll(".room-filter-btn");
      if (btns.length === 0) return;
      btns.forEach((b) => b.addEventListener("click", () => {
        const filter = b.getAttribute("data-filter");
        btns.forEach((x) => {
          x.classList.toggle("is-active", x === b);
          x.setAttribute("aria-selected", x === b ? "true" : "false");
        });
        const wraps = document.querySelectorAll("[data-room-wrap]");
        wraps.forEach((w) => {
          const cat = w.getAttribute("data-cat");
          const show = filter === "all" || cat === filter;
          w.style.display = show ? "" : "none";
        });
      }));
    }
    // ClientRouter mounts in <head>; astro:page-load fires on initial load
    // AND every CR navigation. Single listener avoids stacking handlers.
    document.addEventListener("astro:page-load", init);
  })();
</script>
