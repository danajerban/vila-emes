---
import LangSwitch from "./LangSwitch.astro";
import SectionDivider from "./SectionDivider.astro";
import { localizedPath, type Lang } from "../i18n/locales";
import { SITE } from "../config/site";

interface Props {
  lang: Lang;
  ui: { home: string; rooms: string; contact: string };
  isHome?: boolean;
  hotelName: string;
  bookLabel: string;
  menuToggleLabel: string;
}
const { lang, ui, isHome = false, hotelName, bookLabel, menuToggleLabel } = Astro.props;

const path = (Astro.url.pathname.replace(/\/+$/, "") || "/");
const links = [
  { href: localizedPath(lang, "/"),        label: ui.home,    activePaths: ["/", `/${lang}`, `/${lang}/`] },
  { href: localizedPath(lang, "/rooms"),   label: ui.rooms,   activePaths: ["/rooms", `/${lang}/rooms`] },
  { href: localizedPath(lang, "/contact"), label: ui.contact, activePaths: ["/contact", `/${lang}/contact`] },
];
---
<header
  id="siteHeader"
  data-transparent={isHome ? "true" : "false"}
  class="fixed top-0 inset-x-0 z-40 h-16 md:h-20 transition-colors duration-300"
>
  <div class="max-w-[1280px] mx-auto h-full px-5 md:px-10 flex items-center justify-between gap-4">
    <a href={localizedPath(lang, "/")} class="flex items-center gap-2 group shrink-0" aria-label={hotelName}>
      <svg width="18" height="24" viewBox="0 0 200 260" class="text-[color:var(--color-terracotta)]" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M100 250 C 102 180 100 100 100 70" />
        <path d="M100 70 C 50 50 30 30 20 10 M100 70 C 60 80 30 100 20 130" />
        <path d="M100 70 C 150 50 170 30 180 10 M100 70 C 140 80 170 100 180 130" />
        <path d="M100 70 C 100 30 95 10 90 0 M100 70 C 105 30 115 15 130 5" />
      </svg>
      <span class="font-serif text-[15px] md:text-[18px] tracking-[0.18em] font-medium">VILA EMES</span>
    </a>

    <nav class="hidden lg:flex items-center gap-7 text-[13px] tracking-[0.18em] uppercase font-medium" aria-label="Primary">
      {links.map((l) => {
        const active = l.activePaths.some((p) => path === p);
        return (
          <a
            href={l.href}
            class={`transition ${active ? "text-[color:var(--color-terracotta)]" : "hover:text-[color:var(--color-terracotta)]"}`}
            aria-current={active ? "page" : undefined}
          >{l.label}</a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2 md:gap-3 lg:gap-4">
      <span class="md:hidden">
        <LangSwitch lang={lang} variant="dropdown" />
      </span>
      <span class="hidden md:inline-flex">
        <LangSwitch lang={lang} variant="inline" />
      </span>
      <a
        href={SITE.links.booking_com}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center px-3 py-1.5 md:px-4 md:py-2 bg-[color:var(--color-terracotta)] hover:bg-[color:var(--color-terracotta-hover)] text-[color:var(--color-cream)] text-[11px] md:text-[12px] tracking-[0.18em] md:tracking-[0.2em] uppercase font-medium rounded transition tappable whitespace-nowrap"
      >{bookLabel}</a>
      <button
        type="button"
        id="mobileNavToggle"
        class="inline-flex lg:hidden hamburger-btn -mr-2"
        aria-label={menuToggleLabel}
        aria-expanded="false"
        aria-controls="mobileNav"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <div
    id="mobileNavBackdrop"
    hidden
    aria-hidden="true"
    class="lg:hidden fixed inset-x-0 top-16 bottom-0"
  ></div>

  <div
    id="mobileNav"
    hidden
    class="lg:hidden fixed inset-x-0 top-16 py-8 px-5 max-h-[calc(100vh-4rem)] overflow-y-auto"
  >
    <nav class="space-y-5 text-center" aria-label="Primary mobile">
      {links.map((l) => (
        <a href={l.href} class="block font-serif text-2xl tracking-[0.04em] font-medium">{l.label}</a>
      ))}
    </nav>
    <SectionDivider class="mt-8 opacity-80" tone="current" />
  </div>
</header>

<style>
  /* Header has two states keyed off [data-transparent] + .is-solid:
     • on hero, not scrolled → PURE TRANSPARENT (Cinematic — white text + heavy shadow)
     • scrolled past hero OR on a non-home page → solid cream + divider
     The .is-solid toggle is driven by an IntersectionObserver on [data-hero] in Base.astro. */
  #siteHeader[data-transparent="true"]:not(.is-solid) {
    color: #ffffff;
    background: transparent;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.65), 0 0 18px rgba(0, 0, 0, 0.35);
  }
  #siteHeader[data-transparent="true"]:not(.is-solid) nav a {
    font-weight: 600;
  }
  #siteHeader.is-solid,
  #siteHeader[data-transparent="false"] {
    color: var(--color-ink);
    background-color: var(--color-cream-elevated);
    border-bottom: 1px solid var(--color-divider);
  }

  /* Backdrop scrim behind the open drawer — soft ink dim, blocks tap-through
     to underlying page content while the drawer is open. cursor: pointer is
     load-bearing on iOS Safari: bare divs without it can swallow taps. */
  #mobileNavBackdrop {
    background-color: rgba(46, 46, 46, 0.30);
    cursor: pointer;
  }

  /* Mobile drawer: solid cream by default; Liquid Glass when on hero (pairs
     with the lang-dropdown menu's matching glass override in is:global below). */
  #mobileNav {
    background-color: var(--color-cream-elevated);
    border-bottom: 1px solid var(--color-divider);
    color: var(--color-ink);
  }
  #siteHeader[data-transparent="true"]:not(.is-solid) #mobileNav {
    background-color: rgba(250, 246, 238, 0.30);
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    border-bottom: none;
    color: #ffffff;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.65), 0 0 18px rgba(0, 0, 0, 0.35);
  }

  /* Hamburger → X transition. Keys off aria-expanded which the toggle
     handler in Base.astro already flips. */
  .hamburger-btn {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: inherit;
  }
  .hamburger-btn .bar {
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.3s ease, opacity 0.2s ease;
    transform-origin: center;
  }
  .hamburger-btn .bar + .bar {
    margin-top: 5px;
  }
  .hamburger-btn[aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .hamburger-btn[aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger-btn[aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }
</style>

<!-- Cross-component state for the lang-dropdown menu: it sits inside this
     header but is styled in LangSwitch.astro under its own scope. Use
     is:global so the parent-state selector reaches across components. -->
<style is:global>
  #siteHeader[data-transparent="true"]:not(.is-solid) .lang-dropdown-menu {
    background: rgba(250, 246, 238, 0.30);
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    border-color: rgba(255, 255, 255, 0.20);
    color: #ffffff;
  }
  #siteHeader[data-transparent="true"]:not(.is-solid) .lang-menu-item {
    color: #ffffff;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.65), 0 0 18px rgba(0, 0, 0, 0.35);
  }
</style>
