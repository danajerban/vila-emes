---
import Eyebrow from "./Eyebrow.astro";
import { SITE } from "../config/site";
import { obscureLink } from "../lib/contact-link";

interface Props {
  heading: string;
  intro: string;
  fields: { name: string; email: string; arrival: string; checkout: string; guests: string; message: string };
  submit: string;
  mailto: {
    subject: string;
    labels: { name: string; email: string; check_in: string; check_out: string; guests: string };
  };
}
const { heading, intro, fields, submit, mailto } = Astro.props;

const mailEncoded = obscureLink(SITE.contact.email);

const inputClass = "px-4 py-3 rounded border border-[color:var(--color-divider)] bg-[color:var(--color-cream-elevated)] focus:outline-none focus:border-[color:var(--color-terracotta)] focus:ring-2 focus:ring-[color:var(--color-terracotta)]/40 focus:ring-offset-1 focus:ring-offset-[color:var(--color-cream)]";
---
<div>
  <Eyebrow>{heading}</Eyebrow>
  <p class="mt-3 font-serif text-lg text-[color:var(--color-ink)]">{intro}</p>

  <form id="contactForm" class="mt-8 grid gap-5">
    <label class="grid gap-1.5">
      <span class="text-sm text-[color:var(--color-muted)]">{fields.name}</span>
      <input type="text" name="name" required class={inputClass} />
    </label>
    <label class="grid gap-1.5">
      <span class="text-sm text-[color:var(--color-muted)]">{fields.email}</span>
      <input type="email" name="email" required class={inputClass} />
    </label>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <label class="grid gap-1.5">
        <span class="text-sm text-[color:var(--color-muted)]">{fields.arrival}</span>
        <input type="date" name="arrival" class={inputClass} />
      </label>
      <label class="grid gap-1.5">
        <span class="text-sm text-[color:var(--color-muted)]">{fields.checkout}</span>
        <input type="date" name="checkout" class={inputClass} />
      </label>
      <label class="grid gap-1.5">
        <span class="text-sm text-[color:var(--color-muted)]">{fields.guests}</span>
        <select name="guests" class={inputClass}>
          <option value="1">1</option><option value="2" selected>2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option>
        </select>
      </label>
    </div>
    <label class="grid gap-1.5">
      <span class="text-sm text-[color:var(--color-muted)]">{fields.message}</span>
      <textarea name="message" rows="5" required class={inputClass}></textarea>
    </label>
    <button type="submit" class="justify-self-start inline-flex items-center px-6 py-3 bg-[color:var(--color-terracotta)] hover:bg-[color:var(--color-terracotta-hover)] text-[color:var(--color-cream)] font-medium tracking-wide rounded transition">
      {submit}
    </button>
  </form>
</div>

<script is:inline define:vars={{ MAIL_ENC: mailEncoded, MAILTO: mailto }}>
  (function () {
    // Outer guard: ClientRouter can re-execute inline scripts on revisit.
    if (window.__contactFormInited) return;
    window.__contactFormInited = true;

    function init() {
      const form = document.getElementById("contactForm");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = data.get("name") || "";
        const email = data.get("email") || "";
        const arrival = data.get("arrival") || "";
        const checkout = data.get("checkout") || "";
        const guests = data.get("guests") || "";
        const message = data.get("message") || "";
        const L = MAILTO.labels;
        const subject = encodeURIComponent(MAILTO.subject.replace("{name}", name));
        const body = encodeURIComponent(
          `${L.name}: ${name}\n${L.email}: ${email}\n${L.check_in}: ${arrival}\n${L.check_out}: ${checkout}\n${L.guests}: ${guests}\n\n${message}\n`
        );
        window.location.href = `mailto:${atob(MAIL_ENC)}?subject=${subject}&body=${body}`;
      });
    }
    // ClientRouter mounts in <head>; astro:page-load fires on initial load
    // AND every CR navigation. Single listener avoids stacking handlers.
    document.addEventListener("astro:page-load", init);
  })();
</script>
