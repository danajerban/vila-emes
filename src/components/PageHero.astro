---
import Eyebrow from "./Eyebrow.astro";
import Handwritten from "./Handwritten.astro";
import PalmDoodle from "./PalmDoodle.astro";
import SunBloom from "./SunBloom.astro";

interface Props {
  eyebrow: string;
  headingPart1: string;
  headingPart2Handwritten: string;
  intro?: string;
  tightBottom?: boolean;
}
const { eyebrow, headingPart1, headingPart2Handwritten, intro, tightBottom = false } = Astro.props;
---
<section
  class:list={[
    "relative isolate overflow-hidden bg-gradient-to-b from-[color:var(--sunset-cream)] via-[color:var(--sunset-sub-bg)]/60 to-[color:var(--color-cream)] pt-28 md:pt-36 md:pb-40",
    tightBottom ? "pb-12" : "pb-16",
  ]}
>
  <SunBloom class="absolute -top-20 -right-12 w-[280px] h-[280px] md:-top-40 md:-right-32 md:w-[800px] md:h-[800px] opacity-95" />
  <SunBloom class="absolute -top-72 -right-72 w-[440px] h-[440px] md:w-[600px] md:h-[600px] opacity-50 hidden md:block" />
  <div
    class="absolute -top-20 -right-16 w-[320px] h-[320px] md:-top-40 md:-right-40 md:w-[880px] md:h-[880px] pointer-events-none opacity-55"
    style="background: conic-gradient(from 195deg at 100% 0%, transparent 0deg, rgba(194, 91, 63, 0.35) 7deg, transparent 16deg, rgba(245, 165, 95, 0.42) 26deg, transparent 36deg, rgba(194, 91, 63, 0.30) 46deg, transparent 58deg, rgba(245, 165, 95, 0.36) 68deg, transparent 78deg, rgba(194, 91, 63, 0.28) 88deg, transparent 100deg); -webkit-mask-image: radial-gradient(ellipse at 100% 0%, black 0%, transparent 65%); mask-image: radial-gradient(ellipse at 100% 0%, black 0%, transparent 65%);"
    aria-hidden="true"
  ></div>

  <div class="absolute left-6 top-32 text-[color:var(--color-terracotta)]/40">
    <PalmDoodle size={120} rotate={-8} opacity={0.55} />
  </div>
  <div class="absolute right-12 bottom-20 text-[color:var(--color-terracotta)]/40">
    <PalmDoodle size={80} rotate={12} opacity={0.45} />
  </div>
  <div class="absolute left-1/4 bottom-10 text-[color:var(--color-terracotta)]/30 hidden md:block">
    <PalmDoodle size={64} rotate={-4} opacity={0.4} />
  </div>
  <div class="absolute right-1/3 top-44 text-[color:var(--color-terracotta)]/30 hidden md:block">
    <PalmDoodle size={56} rotate={20} opacity={0.4} />
  </div>

  <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-b from-transparent to-[color:var(--color-cream)] pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-[1180px] mx-auto px-5 md:px-10 text-center">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h1 class="mt-4 font-serif text-6xl md:text-8xl text-[color:var(--color-ink)] leading-none">
      {headingPart1}{" "}
      <Handwritten as="em" color="terracotta" class="not-italic">{headingPart2Handwritten}</Handwritten>
    </h1>
    {intro && <p class="mt-6 max-w-2xl mx-auto text-lg text-[color:var(--color-ink)]/80">{intro}</p>}
    <slot />
  </div>
</section>
