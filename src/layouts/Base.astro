---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { LOCALE_TO_LANG, type Lang } from "../i18n/locales";
import { getSite } from "../i18n/content";
import Seo from "../components/Seo.astro";
import { hotelJsonLd, jsonLdScriptBody } from "../lib/seo";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  noindex?: boolean;
}
const { lang, title, description, noindex = false } = Astro.props;

const htmlLang = LOCALE_TO_LANG[lang];

const site = await getSite(lang);
const waText = site.data.home.ready_cta?.wa_text ?? "Hello, I'd like to book at Vila Emes";

const jsonLd = hotelJsonLd(site.data.hotel.name, site.data.hotel.tagline);
---
<!doctype html>
<html lang={htmlLang} data-vibe="sunset">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <Seo lang={lang} title={title} description={description} pathname={Astro.url.pathname} noindex={noindex} />
    {!noindex && <script is:inline type="application/ld+json" set:html={jsonLdScriptBody(jsonLd)}></script>}

    <ClientRouter />
  </head>
  <body class="bg-[color:var(--color-cream)] text-[color:var(--color-ink)] min-h-screen">
    <slot />
    <WhatsAppFloat waText={waText} ariaLabel={site.data.ui.aria_labels.whatsapp_float} />

    <script is:inline>
      (function () {
        // Outer guard: only the FIRST script execution per session sets up
        // window-scoped listeners. Inline scripts can re-execute when
        // ClientRouter navigates back to a page, and window/document
        // listeners don't get GC'd with the swapped DOM.
        if (window.__baseInited) return;
        window.__baseInited = true;

        // Header transparent ↔ cream toggle, anchored to the hero element
        // itself rather than a scrollY threshold. While ANY part of the
        // hero is in the viewport, header is in its transparent state.
        // Once the hero has fully scrolled out of view, header solidifies
        // to cream. Content-anchored — immune to iOS URL-bar reflow and
        // ClientRouter scroll restoration that can otherwise mis-fire a
        // pixel-based threshold on the visual "top" of the page.
        let headerStateIO = null;
        function bindHeaderState() {
          const hero = document.querySelector("[data-hero]");
          const header = document.getElementById("siteHeader");
          if (!header) return;
          if (header.dataset.transparent !== "true") return;
          if (headerStateIO) headerStateIO.disconnect();
          if (!hero) {
            // Transparent home page without a hero element — keep header
            // in transparent state (rare but defensive).
            header.classList.remove("is-solid");
            return;
          }
          headerStateIO = new IntersectionObserver(([entry]) => {
            if (header.dataset.transparent !== "true") return;
            header.classList.toggle("is-solid", !entry.isIntersecting);
          }, { threshold: 0 });
          headerStateIO.observe(hero);
        }

        function init() {
          // Header state — transparent on home hero, cream when scrolled past or off-home.
          const header = document.getElementById("siteHeader");
          if (header) {
            if (header.dataset.transparent !== "true") {
              header.classList.add("is-solid");
            } else {
              header.classList.remove("is-solid");
              bindHeaderState();
            }
          }

          // Mobile nav toggle — body scroll-lock while open + close-on-link.
          const btn = document.getElementById("mobileNavToggle");
          const nav = document.getElementById("mobileNav");
          if (btn && nav) {
            const closeNav = () => {
              nav.hidden = true;
              btn.setAttribute("aria-expanded", "false");
              document.body.style.overflow = "";
            };
            btn.addEventListener("click", () => {
              const willOpen = nav.hidden;
              nav.hidden = !willOpen;
              btn.setAttribute("aria-expanded", String(willOpen));
              document.body.style.overflow = willOpen ? "hidden" : "";
            });
            nav.querySelectorAll("a").forEach((a) => {
              a.addEventListener("click", closeNav);
            });
          }

          // Reveal-on-scroll (.reveal + .reveal-stagger)
          const targets = document.querySelectorAll(".reveal, .reveal-stagger");
          if (!("IntersectionObserver" in window) || targets.length === 0) {
            targets.forEach((t) => t.classList.add("is-visible"));
          } else {
            const io = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  io.unobserve(entry.target);
                }
              });
            }, { rootMargin: "0px 0px -10% 0px", threshold: 0.05 });
            targets.forEach((t) => io.observe(t));
          }

          // Photo-enter
          const photos = document.querySelectorAll(".photo-enter");
          if ("IntersectionObserver" in window && photos.length) {
            const photoIO = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-entered");
                  photoIO.unobserve(entry.target);
                }
              });
            }, { rootMargin: "0px 0px -8% 0px", threshold: 0.1 });
            photos.forEach((p) => photoIO.observe(p));
          }

          // Number count-ups: any element with [data-count-up]
          const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const counters = document.querySelectorAll("[data-count-up]");
          if (!reduced && "IntersectionObserver" in window && counters.length) {
            const countIO = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target;
                const target = parseFloat(el.getAttribute("data-count-up") || "0");
                if (!Number.isFinite(target)) return;
                const decimals = parseInt(el.getAttribute("data-count-decimals") || "0", 10) || (target.toString().split(".")[1] || "").length;
                const duration = 1200;
                const start = performance.now();
                const initial = 0;
                const tick = (now) => {
                  const t = Math.min(1, (now - start) / duration);
                  const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
                  el.textContent = (initial + (target - initial) * eased).toFixed(decimals);
                  if (t < 1) requestAnimationFrame(tick);
                  else el.textContent = target.toFixed(decimals);
                };
                requestAnimationFrame(tick);
                countIO.unobserve(el);
              });
            }, { threshold: 0.5 });
            counters.forEach((c) => countIO.observe(c));
          } else {
            counters.forEach((c) => {
              const target = parseFloat(c.getAttribute("data-count-up") || "0");
              if (!Number.isFinite(target)) return;
              const decimals = parseInt(c.getAttribute("data-count-decimals") || "0", 10) || (target.toString().split(".")[1] || "").length;
              c.textContent = target.toFixed(decimals);
            });
          }
        }

        // ClientRouter is mounted in <head>, so astro:page-load fires on
        // initial load AND every subsequent CR navigation. Listening on it
        // alone gives us a single init() per page lifecycle. Listening to
        // DOMContentLoaded too would stack non-idempotent addEventListener
        // bindings (e.g. mobileNavToggle) on initial load.
        document.addEventListener("astro:page-load", init);
      })();
    </script>

    <script is:inline>
      (function () {
        // Decode tel:/wa.me/ links that were base64-encoded at build time
        // (see src/lib/contact-link.ts). Document-level delegation, set up
        // once per session — survives ClientRouter DOM swaps.
        if (window.__contactObfInited) return;
        window.__contactObfInited = true;
        document.addEventListener("click", function (e) {
          var a = e.target.closest("a[data-clx]");
          if (!a) return;
          e.preventDefault();
          var url;
          try { url = atob(a.getAttribute("data-clx")); } catch (_) { return; }
          if (a.target === "_blank") {
            window.open(url, "_blank", "noopener");
          } else {
            window.location.href = url;
          }
        });
      })();
    </script>
  </body>
</html>
